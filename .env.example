# ============================================================
# APLIKASI
# ============================================================
APP_NAME="Ular Tangga Statistik Indonesia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# DATABASE (MySQL)
# ============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ular_tangga_statistik_v2
DB_USERNAME=root
DB_PASSWORD=

# Kredensial akun Admin awal (dipakai AdminUserSeeder) - JANGAN commit nilai asli
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================
# GOOGLE OAUTH (Login/Register via Laravel Socialite)
# ------------------------------------------------------------
# Ambil dari Google Cloud Console > APIs & Services > Credentials >
# OAuth 2.0 Client ID (tipe "Web application").
# GOOGLE_REDIRECT_URI HARUS didaftarkan persis sama di Google Cloud Console
# (menu "Authorized redirect URIs") dan HARUS cocok dengan APP_URL di atas -
# kalau APP_URL berubah (mis. jadi http://127.0.0.1:8000), ganti juga URI ini.
#
# Selama GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET masih kosong, klik tombol
# "Google" akan diam-diam mengembalikan pengguna ke halaman asal (BUKAN Error
# 400 dari Google) - detail lengkap ditulis ke storage/logs/laravel.log,
# lihat App\Exceptions\OAuthProviderNotConfiguredException.
#
# Panduan lengkap step-by-step membuat kredensial Google/GitHub OAuth ada di
# docs/OAUTH_SETUP.md - baca dulu sebelum mengisi variabel di bawah ini.
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ============================================================
# GITHUB OAUTH (Login/Register via Laravel Socialite)
# ------------------------------------------------------------
# Ambil dari GitHub > Settings > Developer settings > OAuth Apps.
# GITHUB_REDIRECT_URI HARUS didaftarkan persis sama di GitHub ("Authorization
# callback URL") dan HARUS cocok dengan APP_URL di atas.
# ============================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

# ============================================================
# MAIL (SMTP) - email verifikasi & reset password
# ------------------------------------------------------------
# WAJIB smtp/resend (bukan "log") supaya email verifikasi/reset password
# benar-benar terkirim ke inbox pengguna, bukan hanya tertulis ke
# storage/logs/laravel.log. Semua email dikirim lewat queue
# (QUEUE_CONNECTION=database di atas) - jalankan `php artisan queue:work`
# supaya benar-benar terkirim.
#
# Cukup ganti MAIL_HOST/MAIL_PORT/MAIL_USERNAME/MAIL_PASSWORD sesuai provider
# yang dipakai - tidak perlu mengubah kode apa pun. Contoh nilai per provider:
#
#   Gmail SMTP   : MAIL_HOST=smtp.gmail.com        MAIL_PORT=587
#                  MAIL_USERNAME=alamat@gmail.com  MAIL_PASSWORD=App Password
#                  (BUKAN password akun biasa - buat di
#                  myaccount.google.com/apppasswords, akun harus punya
#                  2-Step Verification aktif)
#   Mailtrap     : MAIL_HOST=sandbox.smtp.mailtrap.io  MAIL_PORT=2525
#                  MAIL_USERNAME=<inbox username>      MAIL_PASSWORD=<inbox password>
#                  (mode testing - email tidak keluar ke inbox asli, cocok untuk staging)
#   Brevo        : MAIL_HOST=smtp-relay.brevo.com   MAIL_PORT=587
#                  MAIL_USERNAME=<akun Brevo>        MAIL_PASSWORD=<SMTP key Brevo>
#   SMTP lain    : isi MAIL_HOST/MAIL_PORT/MAIL_USERNAME/MAIL_PASSWORD sesuai
#                  panduan provider tsb (MAIL_SCHEME=smtp/tls sesuai port)
#
#   Resend       : provider ini pakai HTTP API, BUKAN SMTP - set
#                  MAIL_MAILER=resend (bukan smtp) lalu isi RESEND_API_KEY di
#                  bawah (config/services.php sudah membaca env ini secara
#                  otomatis, transport "resend" juga sudah tersedia bawaan di
#                  config/mail.php - tidak perlu MAIL_HOST/PORT/USERNAME/PASSWORD).
#                  RESEND_API_KEY=
# ============================================================
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# AWS (opsional, hanya jika pakai S3/SES)
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================
# PUSHER (broadcasting realtime)
# ------------------------------------------------------------
# Dipakai di hosting shared (mis. Hostinger) yang tidak bisa menjalankan
# proses permanen seperti Reverb. Daftar gratis di pusher.com > Channels,
# buat app baru, lalu salin app_id/key/secret/cluster ke bawah ini.
# ============================================================
BROADCAST_CONNECTION=pusher

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
